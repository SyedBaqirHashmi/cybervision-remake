# Canonical deployment origin. Required for form origin verification.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use a verified sender domain in your Resend account; keep all secrets server-only.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_TO=info@cybervision.com.pk
# Upstash Redis REST credentials enable atomic, shared rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
# Use only a header overwritten by your trusted hosting ingress.
# Vercel supplies x-vercel-forwarded-for. Missing header uses one shared bucket.
TRUSTED_IP_HEADER=x-vercel-forwarded-for
